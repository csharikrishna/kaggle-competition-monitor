# Kaggle credentials
#
# NEW format (KGAT_... token) - from kaggle.com/settings -> API -> Create Token:
KAGGLE_API_TOKEN=your_KGAT_token_here
#
# OLD format (username + key from kaggle.json) - use this OR the above, not both:
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# Telegram bot credentials
# Get token from @BotFather on Telegram -> /newbot
TELEGRAM_BOT_TOKEN=

# Optional default chat ID(s) (comma-separated for multiple recipients)
# Note: Any user sending /start to the bot is automatically subscribed
TELEGRAM_CHAT_ID=

# Monitoring & Scoring parameters
MIN_SCORE=75            # Minimum score threshold to trigger alert (0-100)
MAX_PAGES=3             # Kaggle API pages to fetch (100 competitions/page)
MAX_DATASET_MB=5120     # Max dataset size in MB to alert (5120 MB = 5 GB)
MIN_DAYS_REMAINING=7    # Minimum days remaining until competition deadline
POLL_INTERVAL_HOURS=6   # Background scan interval in hours for daemon mode
PORT=10000              # Port for HTTP health probe (Render / Cloud platforms)

